<!--
  Windows installer (MSI) for Klimaatatlas, built with WiX Toolset 5 (MS-RL license, free).
  Built from the command line with `dotnet build`; no Visual Studio needed.
  Normally you don't build this yourself: build-release.ps1 in the repo root publishes the app,
  builds this MSI and signs everything.

  Input:  the self-contained win-x64 publish of the GUI (profile Installer-win-x64).
  Output: bin\Release\Klimaatatlas-<version>-x64.msi
-->
<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <OutputName>Klimaatatlas-$(Version)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <AppPublishDir Condition="'$(AppPublishDir)' == ''">$(MSBuildThisFileDirectory)..\src\Klimaatatlas.Gui\bin\Release\net10.0\win-x64\publish\</AppPublishDir>
    <!-- ICE60: versioned non-font files without a language (the .NET runtime files); harmless -->
    <SuppressIces>ICE60</SuppressIces>
    <DefineConstants>Version=$(Version);AppPublishDir=$(AppPublishDir)</DefineConstants>
  </PropertyGroup>

  <Target Name="CheckPublishDir" BeforeTargets="Build">
    <Error Condition="!Exists('$(AppPublishDir)Klimaatatlas.exe')"
           Text="No published app found in '$(AppPublishDir)'. Run build-release.ps1, or first: dotnet publish src\Klimaatatlas.Gui -p:PublishProfile=Installer-win-x64" />
    <Error Condition="'$(Version)' == '0.0.0'" Text="Pass a version, e.g. -p:Version=2.0.1" />
  </Target>
</Project>
