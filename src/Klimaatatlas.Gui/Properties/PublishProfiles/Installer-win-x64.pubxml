<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicatie voor de MSI (setup-project SetupKlimaatAtlas, "Publish Items").
  Self-contained: .NET 10 zit in de app, de gebruiker hoeft niets apart te installeren.
  Alleen win-x64, zodat er geen native bibliotheken voor andere platforms meekomen.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Release\net10.0\win-x64\publish\</PublishDir>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
