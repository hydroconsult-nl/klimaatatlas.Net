<?xml version="1.0" encoding="utf-8"?>
<!--
  Cross-platform publication: one folder that runs on Windows, macOS and Linux.
  Framework-dependent: the .NET 10 runtime must be installed on the computer
  (https://dotnet.microsoft.com/download/dotnet/10.0). Start with:  dotnet Klimaatatlas.dll
  (on Windows Klimaatatlas.exe also works). The runtimes\ folder holds the native libraries
  (SQLite, Skia) for every platform.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0\publish\portable\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
